<schemalist gettext-domain="gnome-weather@mlkonrad.github.com">
  <enum id="org.gnome.shell.extensions.gnome-weather.position">
    <value nick="center" value="0" />
    <value nick="right" value="1" />
    <value nick="left" value="2" />
  </enum>
  <enum id="org.gnome.shell.extensions.gnome-weather.wind-dir-indicators">
    <value nick="arrows" value="0" />
    <value nick="letters" value="1" />
  </enum>
  <schema id="org.gnome.shell.extensions.gnome-weather" path="/org/gnome/shell/extensions/gnome-weather/">
    <key name="city" type="av">
      <default>[]</default>
      <summary>Cities to be displayed</summary>
    </key>
    <key name="actual-city" type="i">
      <default>0</default>
      <summary>Currently selected city</summary>
    </key>
    <key name="use-symbolic-icons" type="b">
      <default>true</default>
      <summary>Use symbolic icons</summary>
    </key>
    <key name="show-text-in-panel" type="b">
      <default>true</default>
      <summary>Show temperature in panel</summary>
    </key>
    <key name="show-comment-in-panel" type="b">
      <default>false</default>
      <summary>Show conditions in panel</summary>
    </key>
    <key name="position-in-panel" enum="org.gnome.shell.extensions.gnome-weather.position">
      <default>'center'</default>
      <summary>Position in panel</summary>
    </key>
    <key name="wind-direction" type="b">
      <default>true</default>
      <summary>Wind direction by arrows</summary>
      <description>Choose whether to display wind direction through arrows or letters.</description>
    </key>
    <key name="debug-extension" type="b">
      <default>false</default>
      <summary>Enable verbose debug logging</summary>
    </key>
  </schema>
</schemalist>
