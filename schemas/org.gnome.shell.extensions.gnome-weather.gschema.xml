<schemalist gettext-domain="gnome-weather@mlkonrad.github.com">
  <enum id="org.gnome.shell.extensions.gnome-weather.position">
    <value nick="center" value="0" />
    <value nick="right" value="1" />
    <value nick="left" value="2" />
  </enum>
  <enum id="org.gnome.shell.extensions.gnome-weather.wind-dir-indicators">
    <value nick="arrows" value="0" />
    <value nick="letters" value="1" />
  </enum>
  <enum id="org.gnome.shell.extensions.gnome-weather.time-format">
    <value nick="auto" value="0" />
    <value nick="12h" value="1" />
    <value nick="24h" value="2" />
  </enum>
  <schema id="org.gnome.shell.extensions.gnome-weather" path="/org/gnome/shell/extensions/gnome-weather/">
    <key name="city" type="av">
      <default>[]</default>
      <summary>Cities to be displayed</summary>
    </key>
    <key name="actual-city" type="i">
      <default>0</default>
      <summary>Currently selected city</summary>
    </key>
    <key name="use-symbolic-icons" type="b">
      <default>true</default>
      <summary>Use symbolic icons</summary>
    </key>
    <key name="show-text-in-panel" type="b">
      <default>true</default>
      <summary>Show temperature in panel</summary>
    </key>
    <key name="show-comment-in-panel" type="b">
      <default>false</default>
      <summary>Show conditions in panel</summary>
    </key>
    <key name="show-humidity-in-panel" type="b">
      <default>false</default>
      <summary>Show humidity in panel</summary>
    </key>
    <key name="show-wind-in-panel" type="b">
      <default>false</default>
      <summary>Show wind speed in panel</summary>
    </key>
    <key name="position-in-panel" enum="org.gnome.shell.extensions.gnome-weather.position">
      <default>'center'</default>
      <summary>Position in panel</summary>
    </key>
    <key name="wind-direction" type="b">
      <default>true</default>
      <summary>Wind direction by arrows</summary>
      <description>Choose whether to display wind direction through arrows or letters.</description>
    </key>
    <key name="show-feels-like" type="b">
      <default>true</default>
      <summary>Show "Feels like" in details</summary>
    </key>
    <key name="show-visibility" type="b">
      <default>true</default>
      <summary>Show visibility in details</summary>
    </key>
    <key name="show-humidity" type="b">
      <default>true</default>
      <summary>Show humidity in details</summary>
    </key>
    <key name="show-pressure" type="b">
      <default>true</default>
      <summary>Show pressure in details</summary>
    </key>
    <key name="show-wind" type="b">
      <default>true</default>
      <summary>Show wind in details</summary>
    </key>
    <key name="show-daily-forecast" type="b">
      <default>true</default>
      <summary>Show daily forecast</summary>
    </key>
    <key name="forecast-days" type="i">
      <range min="1" max="10"/>
      <default>5</default>
      <summary>Number of forecast days to show</summary>
    </key>
    <key name="show-hourly-forecast" type="b">
      <default>true</default>
      <summary>Show hour-by-hour forecast</summary>
    </key>
    <key name="hourly-forecast-count" type="i">
      <range min="1" max="48"/>
      <default>24</default>
      <summary>Number of hours to show in the hour-by-hour forecast</summary>
    </key>
    <key name="time-format" enum="org.gnome.shell.extensions.gnome-weather.time-format">
      <default>'auto'</default>
      <summary>Time format</summary>
      <description>Choose 12-hour, 24-hour, or automatic (follow the system clock format) time display.</description>
    </key>
  </schema>
</schemalist>
